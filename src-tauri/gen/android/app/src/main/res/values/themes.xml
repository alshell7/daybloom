<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The window starts in the planner's own ground colour, so nothing white shows before
         the page draws (DevicePlugin then keeps it to the theme picked in the app). -->
    <style name="Theme.daybloom" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>

    <!-- The start: the icon on the ground colour until the first screen is ready (MainActivity). -->
    <style name="Theme.daybloom.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.daybloom</item>
    </style>
</resources>
