<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: add a block, or start a focus. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add"
        android:enabled="true"
        android:icon="@drawable/ic_stat_daybloom"
        android:shortcutShortLabel="@string/shortcut_add">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.daybloom"
            android:targetClass="app.daybloom.MainActivity">
            <extra android:name="daybloom.action" android:value="capture" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="focus"
        android:enabled="true"
        android:icon="@drawable/ic_stat_daybloom"
        android:shortcutShortLabel="@string/shortcut_focus">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.daybloom"
            android:targetClass="app.daybloom.MainActivity">
            <extra android:name="daybloom.action" android:value="focus" />
        </intent>
    </shortcut>
</shortcuts>
