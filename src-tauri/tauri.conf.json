{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daybloom",
  "version": "../package.json",
  "identifier": "app.daybloom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Daybloom",
        "width": 1120,
        "height": 740,
        "minWidth": 400,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling"
      },
      {
        "label": "widget",
        "title": "Daybloom Widget",
        "url": "index.html",
        "width": 280,
        "height": 280,
        "minWidth": 180,
        "minHeight": 180,
        "maxWidth": 560,
        "maxHeight": 560,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "acceptFirstMouse": true,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src https://api.github.com 'self' ipc: http://ipc.localhost https://www.googleapis.com https://oauth2.googleapis.com https://openidconnect.googleapis.com https://huggingface.co https://*.hf.co https://*.huggingface.co",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A visual day timer that makes time a shape.",
    "longDescription": "Daybloom is a lightweight, sectograph-style visual day planner and timer. Your plans become arcs around a clock face, so the time left in a block, before the next thing, and in the day is something you see at a glance \u2014 designed first for people who experience time blindness.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExRkRCN0ZCOTNFRkM0QkYKUldTL3hPK1QrN2Y5b1p0dEpKWlRpeDFEYVJTaHlmaWJrendsejNyWWQ0UjNjMTlqSnJFdG0zQmkK",
      "endpoints": [
        "https://github.com/alshell7/daybloom/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
