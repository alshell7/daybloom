{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions every Daybloom window has, on every platform: the planner (main) and, on a computer, the desktop dial (widget), the screen cues (overlay) and the quick-capture card (capture).",
  "windows": [
    "main",
    "widget",
    "overlay",
    "capture"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "ms-settings:privacy-microphone"
        },
        {
          "url": "x-apple.systempreferences:com.apple.preference.security?Privacy_Microphone"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        }
      ]
    }
  ]
}
